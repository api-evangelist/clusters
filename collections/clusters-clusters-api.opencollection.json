{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authentication Clusters API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Clusters",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a cluster",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.clusters.xyz/v1/clusters",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a cluster. Requires a wallet-signature bearer token."
        },
        {
          "info": {
            "name": "Get cluster by id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.clusters.xyz/v1/clusters/id/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get the cluster for an id."
        },
        {
          "info": {
            "name": "Get cluster by name",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.clusters.xyz/v1/clusters/name/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get the cluster for a name."
        }
      ]
    }
  ],
  "bundled": true
}